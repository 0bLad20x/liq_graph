# Jupiter Search: independent typed source, controlled by the RAM Mint Registry.
# Persistence exclusively owns SQL; no Jupiter-owned cursor or database lease.
# --jupiter-mint-backfill is an explicitly requested finite scan of known pool mints.
# Qualified mints and previously unqualified mints can be revisited economically.
JUPITER_SEARCH_API_KEYS=
JUPITER_SEARCH_URL=https://api.jup.ag/tokens/v2/search
JUPITER_SEARCH_CALLS_PER_MINUTE=57
JUPITER_SEARCH_BATCH_SIZE=100
JUPITER_SEARCH_REQUEST_TIMEOUT_SECONDS=20
JUPITER_BACKFILL_INTERVAL_SECONDS=86400
# 0 means scan every known mint; set a small number for a finite live probe.
JUPITER_MINT_BACKFILL_LIMIT=0

# Persistence: set LIQ_GRAPH_DATABASE_URL (or DATABASE_URL) privately in .env.
# The application loads .env; external SQL clients require their own connection settings.
# --run supervises Discovery, Completion, Registry, PostgreSQL and Graph together.
# Individual --test <worker_module> runs remain available for module diagnostics.
# LIQ_GRAPH_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# RPC transport. Provider indices are autodiscovered; there is no provider COUNT.
# All limits and capability switches are LOCAL configuration, not verified provider entitlements.
# CP9A directed minimum-notional prequalification (DLMM / PumpSwap).
# Reference: 1 USDC = 1 USD, 1 WSOL = 100 USD, intentionally fixed.
# A dust direction never removes its pool/account watches. Unknown stays executable.
# off disables; shadow measures without veto; filter removes proved dust
# from the directed price index. 0 USD disables threshold.
GRAPH_MIN_DIRECTION_NOTIONAL_USD=1
GRAPH_DIRECTION_LIQUIDITY_MODE=filter

# CP9B: strict graph Direct2-only mode, no Direct3 or Triangle3/4 built.
# False preserves the full graph when running another checkpoint.
GRAPH_DIRECT2_ONLY=false
# Parallel V10 simulation tasks; shared RPC scheduler applies provider limits.
# 1 is the serial baseline; test 4 then 8 after provider capacity checks.
GRAPH_V10_SIMULATION_PARALLELISM=1

# CP9C Direct2 alternative selection: baseline / contrarian / mixed / all.
# 'all' sends up to three different pool packages from one signal revision.
# No new amount exclusion policy; never broadcasts real transactions.
GRAPH_CP9C_PACKING_MODE=baseline

RPC_COMMITMENT=confirmed
RPC_ACCOUNT_BATCH_SIZE=100
RPC_V2_PAGE_LIMIT=5000
RPC_STATS_INTERVAL_SECONDS=30

# PumpSwap V10 signer wallet PUBLIC KEY (not a private key).
# When set, PumpSwap Completion publishes wallet-bound Prepared V10 pool blocks.
# Keep this wallet unchanged for a persisted Prepared cache; a new signer needs revalidation.
# Leave empty to retain wallet-independent PumpSwap validation (Incomplete).
PUMPSWAP_V10_WALLET=

# A lightweight Completion check does not renew the persisted full validation proof.
# Force a complete RPC revalidation at least hourly (seconds; 1..=86400).
COMPLETION_LIFECYCLE_FULL_REFRESH_SECONDS=3600
# For one bounded Byreal legacy UnsupportedConfiguration cohort only. Never set in --run.
# COMPLETION_LIFECYCLE_RECHECK_PAUSED_ONCE=false

# Completion: maximum concurrent 100-account pool partitions (1..=64).
# This is concurrency, not a provider RPS override. Default 32.
DLMM_COMPLETION_PARALLEL_BATCHES=32

RPC_1_NAME=primary
RPC_1_HTTP_URL=
RPC_1_WS_URL=
RPC_1_HTTP_RPS=1
RPC_1_MAX_IN_FLIGHT=1
RPC_1_TIMEOUT_MS=30000
RPC_1_RETRY_ATTEMPTS=2
# Set to false for endpoints that fail getMultipleAccounts (without disabling other methods).
RPC_1_GET_MULTIPLE_ACCOUNTS=true
RPC_1_GET_ACCOUNT_INFO=true
RPC_1_GET_PROGRAM_ACCOUNTS=false
RPC_1_GET_PROGRAM_ACCOUNTS_V2=false
RPC_1_GET_SLOT=true
RPC_1_GET_GENESIS_HASH=true
RPC_1_WS_ACCOUNT_SUBSCRIBE=false
RPC_1_WS_MAX_CONNECTIONS=1
RPC_1_WS_MAX_SUBSCRIPTIONS=1
RPC_1_WS_SUBSCRIPTIONS_PER_CONNECTION=1
RPC_1_WS_SUBSCRIBE_SPACING_MS=10
# Outstanding subscribe/unsubscribe requests per socket, 1..=32 (default 4).
RPC_1_WS_MAX_PENDING_REQUESTS=4
RPC_1_WS_TIMEOUT_MS=45000
RPC_1_WS_RECONNECT_MS=1000

# For more providers add RPC_2_*, RPC_3_* etc. No fixed count or index ceiling.
# API credentials belong in your private .env URLs, never in .env.example.

# REST discovery: existing single-worker tests remain available.
# Raydium: ten sort/direction routes, shared RPS; Orca: five legacy filter routes.
RAYDIUM_API_RPS=10
ORCA_API_RPS=10

# Shared REST DataBatch fan-out and Registry update capacities (32..=65536).
REST_BROADCAST_CAPACITY=256
REGISTRY_BROADCAST_CAPACITY=256
# Normal run: only log lag. Stress-test: set true to fail loudly on any missed batch.
# --rest-discovery-live enforces strict lag detection regardless of this setting.
REST_FAIL_ON_LAG=false

# Log level: error / warn / info / debug. Per-module override follows the source filename.
# --run defaults to info; --test <module> defaults to debug unless overridden.
# LIQ_GRAPH_LOG=info,source_jupiter_mint=debug,graph_liquidity=debug

# Single protocol allowlist for the COMPLETE pipeline; applied at process startup.
# Discovery APIs/RPC, identity hydration, restored/accepted Registry pools,
# Completion lifecycle, Graph, MarketState and automatic V10 candidates use this set.
# Disabled protocol settings are not loaded and their workers do not start.
# Stored rows stay in PostgreSQL; restoring a different selection re-enables them.
# Standalone pool workers also respect the allowlist; unknown/duplicate/empty names fail.
# To re-enable another venue later, append a comma-separated name and restart.
# Supported: meteora_dlmm,meteora_damm_v2,raydium_amm_v4,raydium_cpmm,
# raydium_clmm,raydium_stable,orca_whirlpool,pancakeswap_clmm,
# byreal_clmm,manifest,pumpswap
# raydium_stable has discovery only, without a Completion/MarketState executor.
GRAPH_ENABLED_VENUES=meteora_dlmm,pumpswap

# Registry admission: USD TVL floor except PumpSwap, including non-Pump conversions.
# Fresh canonical protocol TVL, otherwise fresh DexScreener TVL; source age <= 1 hour.
# PumpSwap requires no third-party TVL; identity, mint qualification and proofs stay.
# Other venues wait for TVL enrichment independently of persisted Prepared proofs.
# 0 disables this gate. runtime_live.ps1 exposes -MinPoolTvlUsd (default 500).
POOL_MIN_TVL_USD=500

# Supervised production runtime: cargo run --release --locked -- --run
# Existing single-worker live commands remain compatible; preferred: --test <worker_module>.
# Stop the interactive runtime with q + Enter. A finite live run uses RUN_DURATION_SECONDS.
RUN_DURATION_SECONDS=0
# Signals use the real ExecutionCandidates consumer during simulation.
# For a signal-only proof set RUN_SIGNAL_PROOF=true explicitly (runtime_live.ps1 does this).
RUN_SIGNAL_PROOF=false
# Full Scan is an optional one-shot job, not a routine startup dependency.
RUN_FULL_SCAN=false
# Full execution detail samples per run (0..256); all attempts retain compact JSONL.
# Unique complete request payloads remain available for replay. No broadcasts.
RUN_EXECUTION_DETAIL_LIMIT=16

# CP2 standalone DexScreener read-only live checkpoint (not a runtime service).
# cargo run --release --locked -- --dexscreener-live
# Equivalent: --test source_dexscreener
# Selects deterministic distinct mints from restored Pool Registry (public.pools).
# 10000-Mint load test: set DEXSCREENER_MINT_LIMIT=10000 in the shell.
# If Prepared mints are insufficient, fills from other unique pool-catalog mints.
# Valid range: 1..=10000. Default stays 100 for a quick sanity check.
# Save the larger JSONL under a different DEXSCREENER_REPORT_PATH.
# The worker logs periodic success/throughput/429 progress and a final summary.
# Live test: independent per-proxy-IP budget 280 requests/minute, no shared
# DexScreener host cap. Different ports on one proxy IP share the budget.
# HTTP transport refreshes/revalidates the proxy working set continuously.
# Prefer verified proxies with <= 5000 ms latency; slow fallback if needed.
DEXSCREENER_MINT_LIMIT=100
DEXSCREENER_PARALLEL=48
DEXSCREENER_PROXY_IP_RPM=280
DEXSCREENER_PROXY_MAX_LATENCY_MS=5000
DEXSCREENER_PROXY_WAIT_SECONDS=900
DEXSCREENER_REPORT_PATH=target/dexscreener_cp2.jsonl
