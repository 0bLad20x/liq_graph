# Jupiter Search (optional; enable with keys and a mint file)
JUPITER_SEARCH_API_KEYS=
JUPITER_SEARCH_URL=https://api.jup.ag/tokens/v2/search
JUPITER_SEARCH_CALLS_PER_MINUTE=57
JUPITER_SEARCH_BATCH_SIZE=100
JUPITER_SEARCH_REQUEST_TIMEOUT_SECONDS=20
JUPITER_MINTS_FILE=jupiter_mints.txt

# Persistence: set LIQ_GRAPH_DATABASE_URL (or DATABASE_URL) privately in .env.
# The --stability-live mode continuously scans sources, runs one bounded Completion,
# writes accepted Completion results to PostgreSQL, and keeps the Graph online.
# LIQ_GRAPH_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# RPC transport. Provider indices are autodiscovered; there is no provider COUNT.
# All limits and capability switches are LOCAL configuration, not verified provider entitlements.
RPC_COMMITMENT=confirmed
RPC_ACCOUNT_BATCH_SIZE=100
RPC_V2_PAGE_LIMIT=5000
RPC_STATS_INTERVAL_SECONDS=30

RPC_1_NAME=primary
RPC_1_HTTP_URL=
RPC_1_WS_URL=
RPC_1_HTTP_RPS=1
RPC_1_MAX_IN_FLIGHT=1
RPC_1_TIMEOUT_MS=30000
RPC_1_RETRY_ATTEMPTS=2
RPC_1_GET_MULTIPLE_ACCOUNTS=true
RPC_1_GET_ACCOUNT_INFO=true
RPC_1_GET_PROGRAM_ACCOUNTS=false
RPC_1_GET_PROGRAM_ACCOUNTS_V2=false
RPC_1_GET_SLOT=true
RPC_1_GET_GENESIS_HASH=true
RPC_1_WS_ACCOUNT_SUBSCRIBE=false
RPC_1_WS_MAX_CONNECTIONS=1
RPC_1_WS_MAX_SUBSCRIPTIONS=1
RPC_1_WS_SUBSCRIPTIONS_PER_CONNECTION=1
RPC_1_WS_SUBSCRIBE_SPACING_MS=10
RPC_1_WS_TIMEOUT_MS=45000
RPC_1_WS_RECONNECT_MS=1000

# For more providers add RPC_2_*, RPC_3_* etc. No fixed count or index ceiling.
# API credentials belong in your private .env URLs, never in .env.example.
